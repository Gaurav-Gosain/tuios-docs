<col gap="1">
  <heading level="1">Release v0.11</heading>
  <heading level="2">What changed</heading>
  <text wrap="word">Text holds <b>bold</b>, <i>italic</i>, <u>underline</u>, <s>strike</s>,
    <code>inline code</code>, <c role="success">a role colour</c>, a key such as
    <kbd>ctrl+b</kbd> and <a href="https://tuios.dev">a link</a>.</text>
  <text role="mute" align="right">role="mute" align="right"</text>
</col>
