<tml version="1" title="Build">
  <state>{"pct": 40, "step": "Compiling", "log": ["go vet ./...", "go build ./cmd/tuios"]}</state>
  <col gap="1">
    <row gap="2"><text>Step: <b>{state.step}</b></text><spacer/><badge role="info">{len(state.log)} steps</badge></row>
    <progress value="{state.pct / 100}"/>
    <col><text each="state.log" as="line" role="dim">$ {line}</text></col>
  </col>
</tml>
