<tml version="1">
  <state>{"pkgs": [{"pkg": "session", "s": 6.2}, {"pkg": "app", "s": 4.8}, {"pkg": "vt", "s": 3.1}, {"pkg": "tape", "s": 1.4}],
    "runs": [{"run": 1, "s": 21}, {"run": 2, "s": 23}, {"run": 3, "s": 20}, {"run": 4, "s": 26}, {"run": 5, "s": 24},
      {"run": 6, "s": 19}, {"run": 7, "s": 22}, {"run": 8, "s": 27}, {"run": 9, "s": 25}, {"run": 10, "s": 21}],
    "wall": [41, 39, 44, 40, 52, 47, 38, 45, 49, 43, 41, 50],
    "lang": [{"lang": "Go", "lines": 900}, {"lang": "Shell", "lines": 240}, {"lang": "TOML", "lines": 120}]}</state>
  <grid cols="2" gap="2">
    <bar data="state.pkgs" x="pkg" y="s" dir="h" title="Seconds by package" h="5"/>
    <line data="state.runs" x="run" y="s" title="Suite time" h="5"/>
    <sparkline values="state.wall" title="Wall time"/>
    <pie data="state.lang" label="lang" v="lines" style="donut" h="5"/>
  </grid>
</tml>
