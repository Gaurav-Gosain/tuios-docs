<tml version="1">
  <state>{"ok": 412, "failed": 3, "wall_ms": 18412, "rss": 36700160, "branch": "fix/token-refresh"}</state>
  <kv>
    <item k="Branch" v="{upper(state.branch)}"/>
    <item k="Pass rate" v="{round(pct(state.ok, state.ok + state.failed), 1)}%"/>
    <item k="Wall time" v="{dur(state.wall_ms)}"/>
    <item k="Memory" v="{bytes(state.rss)}"/>
    <item k="Result" v="{state.failed > 0 ? state.failed + ' failed' : 'all passed'}"/>
    <item k="Missing" v="{state.nothing ?? 'no value'}"/>
  </kv>
</tml>
