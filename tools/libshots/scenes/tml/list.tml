<tml version="1">
  <state>{"agents": [
    {"name": "claude", "task": "Add tests for the store", "state": "working"},
    {"name": "codex", "task": "Add a delete endpoint", "state": "needs_input"},
    {"name": "gemini", "task": "Use the system font", "state": "done"}]}</state>
  <list items="state.agents" as="a" select="single">
    <row gap="2"><text w="8">{a.name}</text><text w="fill" role="dim">{a.task}</text><status state="{a.state}"/></row>
  </list>
</tml>
