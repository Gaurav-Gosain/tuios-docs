  <row gap="1">
    <stat label="w=25%" value="a quarter" w="25%" h="3"/>
    <stat label="max-w=18" value="capped" w="fill" max-w="18" h="3" role="info"/>
    <stat label="w=fill" value="the rest" w="fill" h="3" role="success"/>
  </row>
</col>
