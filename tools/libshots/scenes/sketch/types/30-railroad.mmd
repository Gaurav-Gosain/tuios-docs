%% title: Railroad
%% alt: A railroad diagram of the agent selector grammar: terms, keys, values and the separators between them
railroad-ebnf-beta
title "Agent selector"

selector = term ( space term )* ;
term = key ":" value ( "," value )* ;
key = "harness" | "state" | "needs" | "session" | "group" | "host" | "name" | "cwd" ;
value = glob | "you" ;
