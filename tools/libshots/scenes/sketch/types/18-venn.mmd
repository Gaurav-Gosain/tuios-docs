%% title: Venn
%% alt: A Venn diagram of three sets, multiplexer, window manager and agent cockpit, with tuios where all three overlap
venn-beta
  title What tuios is
  set mux["Multiplexer"]
  set wm["Window manager"]
  set cockpit["Agent cockpit"]
  union mux,wm["Tiling panes"]
  union wm,cockpit["Agent rail"]
  union mux,cockpit["Detached agents"]
  union mux,wm,cockpit["tuios"]
