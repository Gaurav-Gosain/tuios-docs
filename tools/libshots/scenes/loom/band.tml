<tml version="1">
  <state>{"passed": 412, "failed": 3, "skipped": 9}</state>
  <col gap="1">
    <text role="mute">view.width = {view.width}, view.band = {view.band}</text>
    <row gap="2" if="view.band == 'wide'">
      <stat h="3" w="fill" label="passed" value="{state.passed}" role="success"/>
      <stat h="3" w="fill" label="failed" value="{state.failed}" role="error"/>
      <stat h="3" w="fill" label="skipped" value="{state.skipped}"/>
    </row>
    <row gap="3" if="view.band != 'wide'">
      <stat label="passed" value="{state.passed}" role="success"/>
      <stat label="failed" value="{state.failed}" role="error"/>
      <stat label="skipped" value="{state.skipped}" if="view.band == 'medium'"/>
    </row>
  </col>
</tml>
