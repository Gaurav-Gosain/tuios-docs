<row gap="2">
  <button key="r" kind="primary" on-press="emit('rerun')">Rerun failed</button>
  <button key="o" on-press="emit('log')">Open log</button>
  <button key="e" on-press="emit('edit')">Open in editor</button>
  <button key="c" on-press="emit('copy')">Copy names</button>
  <spacer/>
  <text role="mute"><kbd>esc</kbd> close</text>
</row>
