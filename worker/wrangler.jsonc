// The docs site on Workers static assets, with index.ts negotiating each
// page between HTML and its markdown twin. Build the site first (bun run
// build in the repo root writes ../out), then: bunx wrangler deploy
{
  "name": "tuios-docs",
  "main": "index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "../out",
    "binding": "ASSETS",
    // The Worker sees every request. Without this, a URL that matches a
    // file is served straight from the assets and never negotiated.
    "run_worker_first": true,
    // /docs/sessions serves out/docs/sessions.html, and unknown paths get
    // out/404.html with a 404 status.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "workers_dev": false
}
