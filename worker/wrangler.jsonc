// The docs site on Workers static assets, with index.ts negotiating each
// page between HTML and its markdown twin. Build the site first (bun run
// build in the repo root writes ../out), then: bunx wrangler deploy
{
  "name": "tuios-docs",
  "account_id": "b99b72423d8ff8a3a14afdee5589683f",
  "main": "index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "../out",
    "binding": "ASSETS",
    // The Worker runs first only where it has work to do: pages (negotiated
    // between HTML and markdown, and moved pages redirected), markdown twins,
    // and release clips. Every other file is served straight from the assets.
    // A request served from the assets never invokes the Worker, so it does
    // not count against the Workers request quota. With true here, each page
    // view also ran the Worker for every chunk, font and image it loaded,
    // and the free daily quota ran out on release day.
    //
    // "*" matches across "/", and a "!" pattern wins over the others. A page
    // path has no dot in its last segment (see isPagePath in negotiate.ts),
    // so excluding the asset extensions leaves pages, .html, .md and the
    // clips (.mp4, .webm) to the Worker.
    "run_worker_first": [
      "/*",
      "!/_next/*",
      "!/api/*",
      "!/*.js",
      "!/*.css",
      "!/*.txt",
      "!/*.json",
      "!/*.xml",
      "!/*.woff2",
      "!/*.woff",
      "!/*.ttf",
      "!/*.svg",
      "!/*.png",
      "!/*.jpg",
      "!/*.jpeg",
      "!/*.webp",
      "!/*.gif",
      "!/*.ico",
      "!/*.glb",
      "!/*.vtt",
      "!/*.wasm",
      "!/*.br",
      "!/*.webmanifest"
    ],
    // /docs/sessions serves out/docs/sessions.html, and unknown paths get
    // out/404.html with a 404 status.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // Release clips (/releases/<version>/*.mp4 and *.webm) are served from this
  // bucket by media.ts, not from the assets. Upload them with
  // scripts/upload-release-media.sh before the page that uses them deploys.
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "tuios-media" }],
  "workers_dev": false,
  // tuios.dev is the site. The other two answer every request with a 301 to
  // the same path on https://tuios.dev (see redirect.ts). tuios.gaurav.zip
  // was the site's first home, so it stays attached for old links.
  "routes": [
    { "pattern": "tuios.dev", "custom_domain": true },
    { "pattern": "www.tuios.dev", "custom_domain": true },
    { "pattern": "tuios.gaurav.zip", "custom_domain": true }
  ]
}
