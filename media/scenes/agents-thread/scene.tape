# The agents view: open it, step through the agents and their threads, look
# at one agent's own screen with ctrl+], and come back with ctrl+b i.
Sleep 600ms
Press "ctrl+b i"
Sleep 900ms
Press "tab"
Sleep 1200ms
Press "s"
Sleep 900ms
Press "g"
Sleep 1800ms
Press "j"
Sleep 1000ms
Press "j"
Sleep 1000ms
Press "k"
Sleep 900ms
Press "k"
Sleep 1200ms
Press "ctrl+]"
Sleep 2200ms
Press "ctrl+b i"
Sleep 1800ms
