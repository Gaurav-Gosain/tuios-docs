<tml version="1" title="Review">
  <state>{"branch": "main", "commits": 3, "files": 3, "add": 40, "del": 0,
    "log": {"window": "shell", "text": "git log --oneline --stat -3\n"}}</state>
  <col pad="1" gap="1">
    <text>Done on <b>{state.branch}</b>: {state.commits} commits, {state.files} files</text>
    <row gap="3">
      <stat label="added" value="+{state.add}" role="success"/>
      <stat label="removed" value="{state.del}" role="error"/>
    </row>
    <row gap="2">
      <button key="l" kind="primary" on-press="pane('send-text', state.log)">Show the log in shell</button>
      <button key="q" on-press="close('done')">Close</button>
    </row>
  </col>
</tml>
