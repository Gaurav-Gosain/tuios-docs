<tml version="1" title="Release">
  <state>{"tag": "v0.11.0", "run": 1, "step": "waiting", "pct": 0, "status": "queued",
    "steps": [{"name": "vet", "secs": 0}, {"name": "test", "secs": 0}, {"name": "build", "secs": 0}, {"name": "sign", "secs": 0}],
    "log": []}</state>
  <col pad="1" gap="1">
    <row gap="2">
      <heading level="1">Release {state.tag}</heading>
      <spacer/>
      <badge role="{state.status == 'done' ? 'success' : 'info'}">run {state.run} · {state.status}</badge>
    </row>
    <row gap="2"><text>Step: <b>{state.step}</b></text><spacer/><text role="mute">{state.pct}%</text></row>
    <progress value="{state.pct / 100}" role="{state.status == 'done' ? 'success' : 'info'}"/>
    <card title="Seconds per step">
      <bar data="state.steps" x="name" y="secs" dir="h" role="series1" h="4"/>
    </card>
    <card title="Log" meta="{len(state.log)}">
      <col><text each="state.log" as="line" role="dim">$ {line}</text></col>
    </card>
    <spacer/>
    <row gap="2">
      <button key="r" kind="primary" on-press="emit('rerun', state.run)">Run again</button>
      <button key="q" on-press="close('done')">Done</button>
    </row>
  </col>
</tml>
