/*
  Content-Security-Policy: default-src 'self'; img-src 'self' data: https:; script-src 'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self'

# The /learn engine lives in a folder named by the hash of its wasm, so a
# new build is a new URL and these files never change.
/learn/engine/*
  Cache-Control: public, max-age=31536000, immutable
